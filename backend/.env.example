# ==============================
# CyberSentryAI - Hybrid AI Configuration
# ==============================
# Architecture: HF Primary → Local Fallback → CyberDNA → RedTeam
# Updated: January 29, 2026

# ==============================
# Hugging Face API (REQUIRED)
# ==============================
# Get your token at: https://huggingface.co/settings/tokens
# System falls back to local models if unavailable

HF_API_TOKEN=your_huggingface_token_here

# ==============================
# Primary Intelligence Models
# ==============================

# Text scam/spam detection (Primary Layer)
# Recommended: distilbert-base-uncased-finetuned-sst-2-english
HF_TEXT_MODEL=distilbert-base-uncased-finetuned-sst-2-english


# URL phishing detection (Primary Layer)
# Recommended: distilbert-base-uncased-finetuned-sst-2-english (same as text)
HF_URL_MODEL=distilbert-base-uncased-finetuned-sst-2-english


# Image deepfake/fake detection (Primary Layer)
# Recommended: dima806/deepfake_vs_real_image_detection
# Alternative: prithivMLmods/DeepFake-Detection
HF_IMAGE_MODEL=dima806/deepfake_vs_real_image_detection

# RedTeam attacker reasoning (Enrichment Layer)
# Recommended: HuggingFaceH4/zephyr-7b-beta (7B parameter instruction model)
# Alternative: mistralai/Mistral-7B-Instruct-v0.2
HF_REDTEAM_MODEL=HuggingFaceH4/zephyr-7b-beta

# CyberDNA embeddings (Enrichment Layer)
# Recommended: sentence-transformers/all-MiniLM-L6-v2 (384 dims, fast)
# Alternative: sentence-transformers/all-mpnet-base-v2 (768 dims, slower but more accurate)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==============================
# Performance & Reliability
# ==============================

# API timeout in seconds (increase for slower networks)
# Recommended: 15 for text/URL, 20 for images, 30 for RedTeam
HF_TIMEOUT=15.0

# Confidence thresholds for classification
# suspicious > 0.25, malicious > 0.45
HF_MIN_PROB=0.25
HF_MAX_PROB=0.45

# ==============================
# Local Server Configuration
# ==============================

API_HOST=0.0.0.0
API_PORT=8000

# ==============================
# Adaptive Learning System
# ==============================
# Automatically retrains local models based on user feedback
# Interval: How often to trigger retraining (in minutes)

RETRAIN_ENABLED=true
RETRAIN_INTERVAL_MIN=1440  # 24 hours

# ==============================
# Security & Admin
# ==============================

ADMIN_PASSWORD=your_admin_password_here

# ==============================
# Email Configuration (for OTP verification)
# ==============================
# SMTP settings for sending verification emails
# For Gmail: Use App Password (not regular password)
# https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=your_email@gmail.com

# ==============================
# System Status
# ==============================
# Architecture: Hybrid AI (HF Primary + Local Fallback + CyberDNA + RedTeam)
# Operational Modes:
#   - HF Available: Cloud AI (primary) + Local (verification) + Enrichment
#   - HF Unavailable: Local AI (primary) + Basic Enrichment
# Last Updated: 2026-01-29
