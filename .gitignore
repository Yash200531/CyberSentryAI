# ==============================
# CyberSentryAI - Root .gitignore
# ==============================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment Variables
.env
.env.local
.env.production
*.env

# Databases
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo
*.swn
*~

# Models (optional - exclude trained models if too large)
# backend/models/*.pkl
# backend/models/*.joblib
# backend/models/*.h5

# Datasets (optional - exclude large datasets)
# datasets/*.csv
# datasets/*.json

# Feedback Data (exclude user data from git)
backend/feedback_data/
frontend/feedback_data/

# Node modules
node_modules/
frontend/node_modules/
CyberSentry-AI-Dashboard/node_modules/

# Frontend build
frontend/dist/
frontend/dist-ssr/
CyberSentry-AI-Dashboard/dist/

# Exports (exclude generated PDFs/reports)
backend/exports/
